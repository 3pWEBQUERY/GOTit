{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^generate",
        "generate",
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".next-*/**",
        "!.next-*/cache/**",
        "dist/**"
      ],
      "env": [
        "APP_NAME",
        "APP_URL",
        "NODE_ENV",
        "NEXT_DIST_DIR"
      ]
    },
    "lint": {
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^generate",
        "generate"
      ]
    },
    "dev": {
      "dependsOn": [
        "^generate",
        "generate"
      ],
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "BETTER_AUTH_SECRET",
    "AGE_GATE_SECRET",
    "APP_URL",
    "APP_ENV",
    "MAIL_TRANSPORT",
    "SMTP_URL",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "ENABLE_DEV_UI",
    "CI",
    "IDENTITY_PROVIDER",
    "STORAGE_DRIVER",
    "STORAGE_FS_ROOT",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_FORCE_PATH_STYLE",
    "S3_ORIGINALS_BUCKET",
    "S3_ORIGINALS_ACCESS_KEY_ID",
    "S3_ORIGINALS_SECRET_ACCESS_KEY",
    "S3_DERIVATIVES_BUCKET",
    "S3_DERIVATIVES_ACCESS_KEY_ID",
    "S3_DERIVATIVES_SECRET_ACCESS_KEY",
    "S3_BACKUPS_BUCKET",
    "S3_BACKUPS_ACCESS_KEY_ID",
    "S3_BACKUPS_SECRET_ACCESS_KEY",
    "BACKUP_AGE_RECIPIENTS",
    "BACKUP_TMP_DIR"
  ]
}
