// Modul stats: Kennzahlen für Anbieter (PRD v1 7.2/7.3, v2 11.1, 11.6, 14.5; Schritt 1.12).
// Rohereignisse enthalten nie eine Besucher-ID, IP-Adresse oder ein Konto: nur Profil, Art und
// Zeit, dazu bei Medien die Medien-ID und bei der Suche den kanonischen Suchschlüssel (nur Filter,
// nie Freitext). Die Tagesaggregation fasst sie in StatDaily zusammen und löscht sie danach.
enum StatKind {
  SEARCH_IMPRESSION
  PROFILE_VIEW
  CONTACT_ACTION
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  FAVORITE_ADDED
  FAVORITE_REMOVED
  MEDIA_VIEW
}

model StatEvent {
  id                String   @id @default(cuid(2))
  providerProfileId String
  kind              StatKind
  // Medienaufrufe: welches Medium. Sonst leer.
  mediaId           String?
  // Einblendungen: kanonischer Filterschlüssel der Suche (Region, Kategorie, …), nie Freitext.
  searchKey         String?
  occurredAt        DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, kind, occurredAt])
  @@index([occurredAt])
  @@map("stat_event")
}

// Tageszahlen pro Profil und Art (Zürcher Kalendertag). `dimension` ist leer für die Gesamtzahl,
// sonst die Medien-ID oder der Suchschlüssel für die Tabellen der Statistik.
model StatDaily {
  providerProfileId String
  day               String
  kind              StatKind
  dimension         String   @default("")
  count             Int

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@id([providerProfileId, day, kind, dimension])
  @@index([providerProfileId, kind, day])
  @@map("stat_daily")
}

// Tage, die schon in StatDaily stehen. Abfragen nehmen für diese Tage die Tageszahlen, für alle
// anderen die Rohereignisse; so zählt nichts doppelt und nichts fehlt.
model StatAggregatedDay {
  day          String   @id
  aggregatedAt DateTime @default(now())

  @@map("stat_aggregated_day")
}
