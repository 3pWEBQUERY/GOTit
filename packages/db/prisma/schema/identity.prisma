// Modul identity: Rollen einer Person. Eine Person hat ein Konto und kann
// mehrere Rollen tragen; Organisationen sind eigene Entitäten (PRD 3).
enum ProviderStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  PUBLISHED
  PAUSED
  // Eingeschränkt durch die Moderation, zum Beispiel ohne Kontaktaktionen (PRD v1 FR-PROFILE-005).
  RESTRICTED
  SUSPENDED
  ARCHIVED
}

enum ProfileAudience {
  PUBLIC
  MEMBERS
}

enum OrganizationKind {
  CLUB
  AGENCY
}

enum OrganizationStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  OWNER
  LOCATION_MANAGER
  MARKETING
  EDITOR
  SCHEDULING
}

model ProviderProfile {
  id          String         @id @default(cuid(2))
  userId      String         @unique
  slug        String         @unique
  displayName String
  status      ProviderStatus @default(DRAFT)
  // Inhalte aus dem Onboarding (PRD 11.8) und dem Profil-Editor (PRD 11.2).
  // Kurzbeschreibung für Karten und Vorschau (PRD v1 FR-PROFILE-001).
  shortDescription String?
  description String?
  languages   String[]       @default([])
  // Allgemeine Ortsangabe wie «Kreis 4», nie eine Adresse (PRD v2 9.3, 16.1).
  locationLabel   String?
  // Kontaktoptionen (PRD v1 FR-PROFILE-004).
  allowMessages        Boolean @default(true)
  allowBookingRequests Boolean @default(true)
  // Sichtbarkeit: öffentlich oder nur für angemeldete Mitglieder.
  visibility      ProfileAudience @default(PUBLIC)
  // Prüfpflichtige Änderungen warten hier, das bisherige Profil bleibt online (PRD v2 11.2).
  pendingChanges  Json?
  // Letzte freiwillige Aktualisierung durch den Anbieter (PRD v1 FR-PROFILE-001).
  contentUpdatedAt DateTime?
  // Erledigte Onboarding-Schritte, zum Beispiel ["identity", "regions"].
  onboardingSteps String[]   @default([])
  submittedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  regions  ProviderRegion[]
  services ProviderService[]
  rates    RateItem[]
  reviews  ProfileReview[]
  statusEvents ProviderStatusEvent[]
  media        MediaAsset[]
  searchEntry  SearchProfile?
  favorites    Favorite[]
  conversations Conversation[]
  calendarSettings CalendarSettings?
  availabilityWindows AvailabilityWindow[]
  calendarBlocks CalendarBlock[]
  bookingRequests BookingRequest[]
  receivedReviews Review[]

  @@index([status])
  @@map("provider_profile")
}

model Organization {
  id        String             @id @default(cuid(2))
  slug      String             @unique
  name      String
  kind      OrganizationKind
  status    OrganizationStatus @default(DRAFT)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  members OrganizationMember[]

  @@map("organization")
}

model OrganizationMember {
  id             String           @id @default(cuid(2))
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_member")
}

// Jeder Statuswechsel eines Anbieterprofils (PRD v1 FR-PROFILE-005). Geschrieben von
// einem Datenbank-Trigger, damit kein Codepfad ihn vergessen kann. Wer und warum
// steht bei Entscheiden im Audit-Log.
model ProviderStatusEvent {
  id                String          @id @default(cuid(2))
  providerProfileId String
  fromStatus        ProviderStatus?
  toStatus          ProviderStatus
  createdAt         DateTime        @default(now())

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([providerProfileId, createdAt])
  @@map("provider_status_event")
}
