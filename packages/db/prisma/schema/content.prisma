// Modul content: CMS für Hilfe, Rechtsseiten und Metadaten (v2 7.8 `/admin/inhalte`, `/admin/seo`).
enum ContentKind {
  HELP
  LEGAL
  PAGE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model ContentPage {
  id              String        @id @default(cuid(2))
  kind            ContentKind
  slug            String
  locale          String
  title           String
  summary         String?
  // Markdown ohne HTML; die Oberfläche rendert ihn sicher.
  body            String
  status          ContentStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  updatedById     String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([kind, slug, locale])
  @@index([kind, locale, status])
  @@map("content_page")
}

// Metadaten für Landingpages und andere Pfade (v2 7.8 `/admin/seo`).
model SeoOverride {
  path        String
  locale      String
  title       String?
  description String?
  noindex     Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([path, locale])
  @@map("seo_override")
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

// Supportanfragen über `/kontakt` (v2 7.8 `/admin/support`).
model SupportTicket {
  id           String        @id @default(cuid(2))
  number       Int           @unique @default(autoincrement())
  userId       String?
  email        String
  category     String
  subject      String
  body         String
  locale       String        @default("de")
  status       SupportStatus @default(OPEN)
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  replies SupportReply[]

  @@index([status, createdAt])
  @@map("support_ticket")
}

model SupportReply {
  id        String   @id @default(cuid(2))
  ticketId  String
  authorId  String
  body      String
  // Interne Notiz, nicht an die anfragende Person.
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_reply")
}
