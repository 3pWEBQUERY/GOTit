// Modul account: Einstellungen, Sicherheitsprotokoll, Ausgang für E-Mails.
enum AccountType {
  MEMBER
  PROVIDER
  ORGANIZATION
}

enum ProfileVisibility {
  MEMBERS
  NOBODY
}

// Einstellungen pro Konto (PRD 7.5). Fehlt die Zeile, gelten die Voreinstellungen.
model UserPreference {
  userId            String            @id
  locale            String?
  theme             String            @default("system")
  reducedMotion     Boolean           @default(false)
  // Neutraler Seitentitel im Browser-Tab (PRD 13, Diskretion).
  neutralTabTitle   Boolean           @default(false)
  showOnlineStatus  Boolean           @default(false)
  readReceipts      Boolean           @default(false)
  profileVisibility ProfileVisibility @default(MEMBERS)
  // Kanäle je Ereignis, zum Beispiel {"message": {"email": true, "push": false}}.
  notifications     Json              @default("{}")
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}

enum SecurityEventType {
  SIGN_IN
  SIGN_OUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  PASSKEY_ADDED
  PASSKEY_REMOVED
  SESSION_REVOKED
  PROFILE_CHANGED
  DATA_EXPORTED
  ACCOUNT_DEACTIVATED
  DELETION_REQUESTED
  ACCOUNT_REACTIVATED
}

// Änderungsprotokoll der Sicherheit (PRD 7.5). Ohne Inhalte, ohne IP-Adresse.
model SecurityEvent {
  id        String            @id @default(cuid(2))
  userId    String
  type      SecurityEventType
  // Gekürzte Geräteangabe, zum Beispiel «Firefox auf macOS».
  device    String?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("security_event")
}

// Ausgang für E-Mails in Entwicklung und Tests. In der Produktion nicht verwendet.
model EmailOutbox {
  id        String   @id @default(cuid(2))
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())

  @@index([to, createdAt])
  @@map("email_outbox")
}

enum ConsentKind {
  TERMS
  PRIVACY
  AGE_CONFIRMATION
  PROFILE_PUBLICATION
}

// Einwilligungen und ihre Rechtsgrundlage (PRD v1 FR-AUTH-001, FR-VERIFY-002, Datenmodell
// ConsentRecord). Version bezeichnet den Stand des Dokuments, dem zugestimmt wurde.
model ConsentRecord {
  id          String      @id @default(cuid(2))
  userId      String
  kind        ConsentKind
  version     String
  grantedAt   DateTime    @default(now())
  withdrawnAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("consent_record")
}
