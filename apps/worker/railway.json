{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@app/worker",
    "watchPatterns": ["apps/worker/**", "packages/core/**", "packages/jobs/**", "packages/db/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @app/worker start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
