{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@app/cron",
    "watchPatterns": ["apps/cron/**", "packages/core/**", "packages/db/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "restartPolicyType": "NEVER"
  }
}
