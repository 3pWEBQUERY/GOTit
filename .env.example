# Produktname: in der PRD offen (Abschnitt 18), deshalb konfigurierbar. «GOTit» ist der Arbeitsname des Repos.
APP_NAME=GOTit
APP_URL=http://localhost:3000
# Umgebung des Deployments: development, test, staging, production. Unabhängig von NODE_ENV (Build-Modus).
APP_ENV=development

# Postgres und Redis. Auf Railway als Referenzvariablen gesetzt, nie im Repo.
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Better Auth: mindestens 32 zufällige Zeichen, pro Umgebung getrennt.
BETTER_AUTH_SECRET=
# Signiert das Cookie der Altersprüfung, pro Umgebung getrennt.
AGE_GATE_SECRET=

# Echtzeit-Dienst
REALTIME_PORT=4001

# E-Mail-Versand. Entwicklung: outbox (Tabelle email_outbox). Produktion: smtp mit SMTP_URL und MAIL_FROM.
# Ohne Angabe ist die Registrierung geschlossen, weil niemand die Bestätigung erhielte.
MAIL_TRANSPORT=outbox
SMTP_URL=
MAIL_FROM=

# Prüfdienstleister für Alters- und Identitätsprüfung (PRD 16.1). test nur ausserhalb der Produktion.
IDENTITY_PROVIDER=test

# Medien (Entscheid 0011). Entwicklung und Tests: fs mit Ablage ausserhalb des Repos, weil Turbopack das Repo
# beobachtet; fs ist in APP_ENV=production verboten. Produktion (Railway): s3 mit zwei privaten Buckets.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/home/user/gotit-local/storage
# Nur bei STORAGE_DRIVER=s3. S3_FORCE_PATH_STYLE=true, wenn der Endpunkt keine Bucket-Subdomains kennt.
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=
S3_ORIGINALS_BUCKET=
S3_ORIGINALS_ACCESS_KEY_ID=
S3_ORIGINALS_SECRET_ACCESS_KEY=
S3_DERIVATIVES_BUCKET=
S3_DERIVATIVES_ACCESS_KEY_ID=
S3_DERIVATIVES_SECRET_ACCESS_KEY=
