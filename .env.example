# Produktname: in der PRD offen (Abschnitt 18), deshalb konfigurierbar. «GOTit» ist der Arbeitsname des Repos.
APP_NAME=GOTit
APP_URL=http://localhost:3000

# Postgres und Redis. Auf Railway als Referenzvariablen gesetzt, nie im Repo.
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# Better Auth: mindestens 32 zufällige Zeichen, pro Umgebung getrennt.
BETTER_AUTH_SECRET=
# Signiert das Cookie der Altersprüfung, pro Umgebung getrennt.
AGE_GATE_SECRET=

# Echtzeit-Dienst
REALTIME_PORT=4001
